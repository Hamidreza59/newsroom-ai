SHOW_NAME=Bits & Bulls

# ollama | openai | mock
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# Any OpenAI-compatible API, e.g. Groq's free tier
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=llama-3.3-70b-versatile

# kokoro | say | silent
TTS_PROVIDER=kokoro
ANCHOR_A_NAME=Maya
ANCHOR_A_VOICE=af_heart
ANCHOR_B_NAME=Leo
ANCHOR_B_VOICE=am_michael
KOKORO_SPEED=1.05

# hashing | ollama
EMBEDDER=hashing

STORIES_PER_SHOW=5
MAX_SECONDS=178
