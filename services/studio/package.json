{
  "name": "newsroom-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Remotion studio that renders newsroom episodes to video",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "node scripts/render.mjs",
    "typecheck": "tsc --noEmit",
    "gen:types": "json2ts --input ../../packages/contracts/episode.schema.json --output src/contract.ts --no-additionalProperties"
  },
  "dependencies": {
    "@remotion/cli": "4.0.541",
    "@remotion/google-fonts": "4.0.541",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "5.9.3"
  }
}
